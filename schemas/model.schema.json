{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sparklet model variant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "name",
    "description",
    "family",
    "architecture",
    "format",
    "quantization",
    "source",
    "downloads",
    "requirements",
    "hardware"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "integer"
    },
    "kind": {
      "const": "model",
      "type": "string"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "family": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "architecture": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "format": {
      "type": "string",
      "enum": [
        "safetensors",
        "gguf",
        "pytorch+safetensors"
      ]
    },
    "quantization": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "revision"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "downloads": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "global",
        "cn"
      ],
      "properties": {
        "global": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "url",
              "revision",
              "verification",
              "manifestUrl",
              "manifestSha256"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "pattern": "^[0-9a-f]{40}$"
              },
              "verification": {
                "type": "string",
                "enum": [
                  "upstream",
                  "sha256-manifest"
                ]
              },
              "manifestUrl": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 1000
              },
              "manifestSha256": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 1000
              }
            }
          },
          "maxItems": 8,
          "minItems": 1
        },
        "cn": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "url",
              "revision",
              "verification",
              "manifestUrl",
              "manifestSha256"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "pattern": "^[0-9a-f]{40}$"
              },
              "verification": {
                "type": "string",
                "enum": [
                  "upstream",
                  "sha256-manifest"
                ]
              },
              "manifestUrl": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 1000
              },
              "manifestSha256": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 1000
              }
            }
          },
          "maxItems": 8,
          "minItems": 0
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "systemRamGiB",
        "gpuMemoryGiB",
        "diskBytes",
        "notes"
      ],
      "properties": {
        "systemRamGiB": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "gpuMemoryGiB": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "diskBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1600
        }
      }
    },
    "hardware": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "status",
          "reportIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "status": {
            "type": "string",
            "enum": [
              "unverified",
              "tested",
              "failed"
            ]
          },
          "reportIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
            },
            "maxItems": 64,
            "minItems": 0
          }
        }
      },
      "maxItems": 32,
      "minItems": 0
    },
    "curation": {
      "description": "Authoring-only review metadata; excluded from served v1 model objects.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "originCountry",
        "rank",
        "reviewedAt",
        "downloads30d",
        "evidence",
        "files"
      ],
      "properties": {
        "originCountry": {
          "type": "string",
          "enum": [
            "CN",
            "US",
            "FR",
            "other",
            "unknown"
          ]
        },
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999
        },
        "reviewedAt": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10
        },
        "downloads30d": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "bytes"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          }
        }
      }
    },
    "optimization": {
      "description": "Authoring-only workbench classification; independent of publication and hardware verification. Missing legacy values mean pending and recommended.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "recommended"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "optimized"
          ]
        },
        "recommended": {
          "type": "boolean"
        }
      }
    },
    "inference": {
      "description": "Authoring-only inference variant identity. Different decoding configurations require distinct model IDs and reports.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "speculativeDecoding",
        "features",
        "performance"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "speculativeDecoding": {
          "type": "string",
          "enum": [
            "none",
            "mtp",
            "dflash",
            "other"
          ]
        },
        "draftModel": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repo",
            "revision"
          ],
          "properties": {
            "repo": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "pattern": "^[0-9a-f]{40}$"
            }
          }
        },
        "features": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "performance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        }
      }
    }
  }
}
